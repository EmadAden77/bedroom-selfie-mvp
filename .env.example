# Server-only secrets: configure these in Vercel Project > Settings > Environment Variables.
# Never prefix either secret with VITE_; never commit real secret values.
GEMINI_API_KEY=
# Long random secret passphrase; user enters this access code into the optional AI panel.
PROMPT_ENGINE_ACCESS_TOKEN=
# Optional: faster low-latency stable text model for short classification tasks.
# Default in server: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
